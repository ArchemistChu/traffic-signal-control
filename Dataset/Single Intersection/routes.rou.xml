<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- 车辆类型定义 -->
    <vType id="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5.0" 
           minGap="2.5" maxSpeed="50" color="red" guiShape="passenger"/>
    
    <vType id="truck" accel="1.3" decel="4.0" sigma="0.5" length="12.0" 
           minGap="3.0" maxSpeed="40" color="yellow" guiShape="truck"/>
    
    <vType id="bus" accel="1.2" decel="4.0" sigma="0.5" length="18.0" 
           minGap="3.5" maxSpeed="35" color="blue" guiShape="bus"/>
    
    <!-- 路由定义 -->
    <!-- 东向进入的路由 -->
    <route id="east_to_west" edges="east_in west_out"/>     <!-- 直行 -->
    <route id="east_to_north" edges="east_in north_out"/>   <!-- 左转 -->
    <route id="east_to_south" edges="east_in south_out"/>   <!-- 右转 -->
    
    <!-- 西向进入的路由 -->
    <route id="west_to_east" edges="west_in east_out"/>     <!-- 直行 -->
    <route id="west_to_south" edges="west_in south_out"/>   <!-- 左转 -->
    <route id="west_to_north" edges="west_in north_out"/>   <!-- 右转 -->
    
    <!-- 北向进入的路由 -->
    <route id="north_to_south" edges="north_in south_out"/> <!-- 直行 -->
    <route id="north_to_east" edges="north_in east_out"/>   <!-- 左转 -->
    <route id="north_to_west" edges="north_in west_out"/>   <!-- 右转 -->
    
    <!-- 南向进入的路由 -->
    <route id="south_to_north" edges="south_in north_out"/> <!-- 直行 -->
    <route id="south_to_west" edges="south_in west_out"/>   <!-- 左转 -->
    <route id="south_to_east" edges="south_in east_out"/>   <!-- 右转 -->
    
    <!-- 车流定义 - 低流量：约300 veh/h (东/西), 约225 veh/h (北/南)，直行:左转:右转 = 6:2:2 -->
    <!-- 东向车流：300 veh/h = 180直行 + 60左转 + 60右转 (3 lanes: 0=right, 1=straight, 2=left) -->
    <flow id="flow_east_right" route="east_to_south" 
          vehsPerHour="60" type="passenger" begin="0" end="7200"
          departLane="0" departSpeed="max"/>
    <flow id="flow_east_straight" route="east_to_west"
          vehsPerHour="180" type="passenger" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="flow_east_left" route="east_to_north"
          vehsPerHour="60" type="passenger" begin="0" end="7200"
          departLane="2" departSpeed="max"/>
          
    <!-- 西向车流：300 veh/h (3 lanes: 0=right, 1=straight, 2=left) -->
    <flow id="flow_west_right" route="west_to_north" 
          vehsPerHour="60" type="passenger" begin="0" end="7200"
          departLane="0" departSpeed="max"/>
    <flow id="flow_west_straight" route="west_to_east"
          vehsPerHour="180" type="passenger" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="flow_west_left" route="west_to_south"
          vehsPerHour="60" type="passenger" begin="0" end="7200"
          departLane="2" departSpeed="max"/>
          
    <!-- 北向车流：225 veh/h (135直行 + 45左转 + 45右转) (3 lanes: 0=right, 1=straight, 2=left) -->
    <flow id="flow_north_right" route="north_to_west" 
          vehsPerHour="45" type="passenger" begin="0" end="7200"
          departLane="0" departSpeed="max"/>
    <flow id="flow_north_straight" route="north_to_south"
          vehsPerHour="135" type="passenger" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="flow_north_left" route="north_to_east"
          vehsPerHour="45" type="passenger" begin="0" end="7200"
          departLane="2" departSpeed="max"/>
          
    <!-- 南向车流：225 veh/h (135直行 + 45左转 + 45右转) (3 lanes: 0=right, 1=straight, 2=left) -->
    <flow id="flow_south_right" route="south_to_east" 
          vehsPerHour="45" type="passenger" begin="0" end="7200"
          departLane="0" departSpeed="max"/>
    <flow id="flow_south_straight" route="south_to_north"
          vehsPerHour="135" type="passenger" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="flow_south_left" route="south_to_west"
          vehsPerHour="45" type="passenger" begin="0" end="7200"
          departLane="2" departSpeed="max"/>
          
    <!-- 卡车流量（30 veh/h 东/西, 20 veh/h 北/南） -->
    <flow id="truck_east" route="east_to_west" 
          vehsPerHour="30" type="truck" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="truck_west" route="west_to_east" 
          vehsPerHour="30" type="truck" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="truck_north" route="north_to_south" 
          vehsPerHour="20" type="truck" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    <flow id="truck_south" route="south_to_north" 
          vehsPerHour="20" type="truck" begin="0" end="7200"
          departLane="1" departSpeed="max"/>
    
</routes> 