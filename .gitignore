**/output/emissions*.xml
**/output/detectors.xml
**/output/fcd_output.xml
**/output/queue.xml
**/output/summary.xml
# Allow CSV, JSON, TXT, MD files in output
# **/output/*.csv  # Commented out
# **/output/*.json  # Commented out
# **/output/*.txt  # Commented out
# **/output/*.md  # Commented out
output/academic/
*.json
!package.json
!requirements.txt
!**/output/*.json

