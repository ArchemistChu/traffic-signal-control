**/queue.xml
**/summary.xml
**/*.log
**/sumo.log
**/cologne.log

# SUMO GUI settings (user-specific)
**/view.settings.xml
**/gui-settings.xml

# Output directories (allow output folder structure, but ignore large runtime XML files)
